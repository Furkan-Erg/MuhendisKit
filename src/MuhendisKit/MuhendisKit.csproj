<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MuhendisKit</RootNamespace>
    <AssemblyName>MuhendisKit</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>MühendisKit</Product>
    <Company>MühendisKit</Company>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The UI is Turkish; skip the framework's other translations in the package. -->
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The WebView2 package also references its WPF control; this is a WinForms app. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MuhendisKit.Core\MuhendisKit.Core.csproj" />
    <!-- The MCP server ships next to the app (MuhendisKit.Mcp.exe). -->
    <ProjectReference Include="..\MuhendisKit.Mcp\MuhendisKit.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
